# Copy to .env for local backend development. Keep real credentials out of git.
APP_ENV=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
REQUIRE_AUTH=false
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=student-documents
LLM_API_KEY=
# Set to a model available to your Gemini API key, for example: gemini-2.5-flash
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
# Optional rule-assist hook; no Gemini-backed rule assist is implemented.
RULE_ASSIST_ENABLED=false
